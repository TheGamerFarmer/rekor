# Copie ce fichier en ".env" (à côté de docker-compose.yml) puis remplace les valeurs.
# Le fichier .env n'est jamais commité : il est dans le .gitignore.

# Compte administrateur de MongoDB.
# Il n'est créé qu'au PREMIER démarrage de la base : définis ces valeurs avant de la lancer.
# Évite le caractère $ dans le mot de passe (Compose le lirait comme une variable).
DB_USER=rekor
DB_PASSWORD=change-me

# Nom de la base de données utilisée par le back
DB_NAME=rekor
