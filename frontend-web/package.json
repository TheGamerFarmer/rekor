{
  "name": "frontend-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "playwright test",
    "test:all": "npm run test:coverage -- --no-watch && npm run e2e",
    "verify": "npm run lint && npm run test:all",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "ng test --no-watch --coverage"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@frxjs/ngx-timeline": "^22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  }
}
